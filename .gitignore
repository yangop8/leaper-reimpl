build/
build-rocksdb/
.venv/
.omc/
__pycache__/
*.pyc

# Result CSVs and figures are part of the artifact and are committed.
# Raw traces and LevelDB info logs are not: they are large and regenerable.
experiments/results/*.trace.*
experiments/results/*.leveldb.log
# Trained models, precursor tables and oracle hot sets are regenerated by the
# experiment scripts (a training run takes ~5 minutes) and add ~14 MB of
# machine-generated text. The measurements they produced are committed.
experiments/results/*.model.*
experiments/results/*.oracle.txt
