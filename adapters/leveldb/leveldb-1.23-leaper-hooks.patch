+void DBImpl::LeaperCompactionBegin(Compaction* c, bool is_flush) {
+  if (options_.leaper_hooks == nullptr) return;
+  std::vector<LeaperBlockInfo> blocks;
+  std::vector<std::string> key_store;  // backs the Slices in |blocks|
+  if (c != nullptr) {
+    for (int which = 0; which < 2; ++which) {
+      for (int i = 0; i < c->num_input_files(which); ++i) {
+        FileMetaData* f = c->input(which, i);
+        table_cache_->ForEachDataBlock(
+            f->number, f->file_size, [&](const LeaperBlockInfo& b) {
+              key_store.emplace_back(b.smallest_key.data(), b.smallest_key.size());
+              key_store.emplace_back(b.largest_key.data(), b.largest_key.size());
+              blocks.push_back(b);
+            });
+      }
+    }
+  }
+  // The index iterator's key buffers do not outlive the walk, and key_store
+  // reallocates during it, so the Slices are re-pointed at the stable copies
+  // only once the vector has stopped growing.
+  for (size_t i = 0; i < blocks.size(); ++i) {
+    blocks[i].smallest_key = Slice(key_store[2 * i]);
+    blocks[i].largest_key = Slice(key_store[2 * i + 1]);
+  }
+  options_.leaper_hooks->OnCompactionBegin(c != nullptr ? c->level() : 0, is_flush,
+                                           blocks);
+}
