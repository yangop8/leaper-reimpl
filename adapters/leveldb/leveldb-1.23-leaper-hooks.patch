+class LeaperWriteObserver : public WriteBatch::Handler {
+ public:
+  explicit LeaperWriteObserver(LeaperHooks* hooks) : hooks_(hooks) {}
+  void Put(const Slice& key, const Slice&) override { hooks_->OnPut(key); }
+  void Delete(const Slice& key) override { hooks_->OnPut(key); }
+
