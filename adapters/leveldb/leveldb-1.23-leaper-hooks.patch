+namespace {
+// Mirrors the block cache key layout in Table::BlockReader below.
+void EncodeBlockCacheKey(uint64_t cache_id, uint64_t offset, char* buf16) {
+  EncodeFixed64(buf16, cache_id);
+  EncodeFixed64(buf16 + 8, offset);
+}
+}  // namespace
+
+void Table::ForEachDataBlock(
+    uint64_t file_number,
+    const std::function<void(const LeaperBlockInfo&)>& cb) const {
+  Iterator* index = rep_->index_block->NewIterator(rep_->options.comparator);
+  std::string prev_key;
+  bool have_prev = false;
+  for (index->SeekToFirst(); index->Valid(); index->Next()) {
+    BlockHandle handle;
+    Slice input = index->value();
+    if (!handle.DecodeFrom(&input).ok()) break;
+    LeaperBlockInfo info;
+    info.file_number = file_number;
+    info.offset = handle.offset();
+    info.size = handle.size();
+    // An index entry's key is >= the block's last key and < the next block's
+    // first key, so it is a valid upper bound; the previous index key bounds
+    // this block from below. That is all the index gives us without reading
+    // the data blocks, and it is enough for an overlap check.
+    info.largest_key = index->key();
+    info.smallest_key = have_prev ? Slice(prev_key) : index->key();
+    cb(info);
+    prev_key.assign(index->key().data(), index->key().size());
+    have_prev = true;
+  }
+  delete index;
+}
+
+void Table::WarmBlock(uint64_t offset, uint64_t size) {
+  if (rep_->options.block_cache == nullptr) return;
+  BlockHandle handle;
+  handle.set_offset(offset);
+  handle.set_size(size);
+  std::string enc;
+  handle.EncodeTo(&enc);
+  ReadOptions ro;
+  ro.fill_cache = true;
+  delete BlockReader(const_cast<Table*>(this), ro, Slice(enc));
+}
+
+void Table::EvictBlock(uint64_t offset) {
+  if (rep_->options.block_cache == nullptr) return;
+  char key[16];
+  EncodeBlockCacheKey(rep_->cache_id, offset, key);
+  rep_->options.block_cache->Erase(Slice(key, sizeof(key)));
+}
+
+bool Table::IsBlockCached(uint64_t offset) const {
+  if (rep_->options.block_cache == nullptr) return false;
+  char key[16];
+  EncodeBlockCacheKey(rep_->cache_id, offset, key);
+  Cache::Handle* h = rep_->options.block_cache->Lookup(Slice(key, sizeof(key)));
+  if (h == nullptr) return false;
+  rep_->options.block_cache->Release(h);
+  return true;
+}
